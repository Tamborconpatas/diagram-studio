{
  "name": "diagram-studio",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Editor local de diagramas: Mermaid, Excalidraw, BPMN, Graphviz, PlantUML y más de 30 formatos",
  "author": "Tamborconpatas <129793076+Tamborconpatas@users.noreply.github.com>",
  "homepage": "https://github.com/Tamborconpatas/diagram-studio",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --plainVertical --out THIRD-PARTY-NOTICES.txt",
    "preview": "vite preview",
    "check": "node scripts/check-wiring.mjs",
    "check-examples": "node scripts/check-examples.mjs",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build && npm run electron:build && electron .",
    "dist:win": "npm run build && npm run electron:build && electron-builder --win --publish never",
    "dist:linux": "npm run build && npm run electron:build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@hpcc-js/wasm-graphviz": "^1.28.0",
    "@mermaid-js/mermaid-zenuml": "^0.2.3",
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "@tailwindcss/vite": "^4.3.0",
    "abcjs": "^6.7.0",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-js": "^18.27.0",
    "d3-sankey": "^0.12.3",
    "json5": "^2.2.3",
    "lucide-react": "^1.17.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.17.2",
    "nomnoml": "^1.7.0",
    "pikchr-wasm": "^2.0.1",
    "plantuml-encoder": "^1.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "smiles-drawer": "^2.4.1",
    "tailwindcss": "^4.3.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3",
    "wavedrom": "^3.7.0"
  },
  "devDependencies": {
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "io.github.tamborconpatas.diagram-studio",
    "productName": "Diagram Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.mjs",
      "electron/dbml.cjs",
      "scripts/diagrams-runner.py",
      "scripts/blockdiag-runner.py",
      "tools/**",
      "LICENSE",
      "NOTICE",
      "THIRD-PARTY-NOTICES.txt",
      "package.json",
      "!**/node_modules/**"
    ],
    "asarUnpack": [
      "electron/dbml.cjs",
      "scripts/*.py",
      "tools/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${name}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Graphics",
      "maintainer": "Tamborconpatas <129793076+Tamborconpatas@users.noreply.github.com>",
      "artifactName": "${name}-${version}.${ext}",
      "syncDesktopName": true
    }
  },
  "desktopName": "diagram-studio.desktop"
}
